{
  "name": "foundation",
  "description": "rushilrai's monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "turbo format && prettier --write \"./*.{js,cjs,mjs,json,md,yml,yaml}\"",
    "format:check": "turbo check && prettier --check \"./*.{js,cjs,mjs,json,md,yml,yaml}\""
  },
  "keywords": [],
  "author": "Rushil Rai",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.0.0"
  },
  "trustedDependencies": [
    "@clerk/shared",
    "@tailwindcss/oxide",
    "esbuild",
    "msw",
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^25.9.9",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  }
}
