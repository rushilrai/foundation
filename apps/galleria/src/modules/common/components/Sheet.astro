---
// Fixed drafting-sheet frame. The box covers the whole viewport; four mat
// panels paint the margin in paper colour so scrolling content disappears
// behind it. The panels bleed a full viewport past every edge because iOS
// Safari resizes fixed boxes a beat behind its bar animations, and the old
// spread shadow was clipped to the layout viewport. viewport-fit=cover lets
// that viewport reach behind the status bar and the floating tab bar.
const MARKS = [
  'top: 0; right: calc(100% + 3px); width: 8px; height: 1px',
  'left: 0; bottom: calc(100% + 3px); width: 1px; height: 8px',
  'top: 0; left: calc(100% + 3px); width: 8px; height: 1px',
  'right: 0; bottom: calc(100% + 3px); width: 1px; height: 8px',
  'bottom: 0; right: calc(100% + 3px); width: 8px; height: 1px',
  'left: 0; top: calc(100% + 3px); width: 1px; height: 8px',
  'bottom: 0; left: calc(100% + 3px); width: 8px; height: 1px',
  'right: 0; top: calc(100% + 3px); width: 1px; height: 8px',
]
---

<div
  id="sheet"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-60"
>
  <div
    class="absolute inset-x-[-100vw] top-[-100vh] h-[calc(100vh+var(--sheet-inset-top))] bg-base-100"
  >
  </div>
  <div
    class="absolute inset-x-[-100vw] bottom-[-100vh] h-[calc(100vh+var(--sheet-inset-bottom))] bg-base-100"
  >
  </div>
  <div
    class="absolute inset-y-0 left-[-100vw] w-[calc(100vw+var(--sheet-inset-x))] bg-base-100"
  >
  </div>
  <div
    class="absolute inset-y-0 right-[-100vw] w-[calc(100vw+var(--sheet-inset-x))] bg-base-100"
  >
  </div>

  <div
    class="absolute inset-x-(--sheet-inset-x) top-(--sheet-inset-top) bottom-(--sheet-inset-bottom)"
  >
    <div class="absolute inset-0 border border-(--sheet-rule)"></div>

    <div class="absolute inset-1.5 border border-(--sheet-rule-faint)"></div>

    {MARKS.map((style) => <div class="sheet-mark" style={style} />)}
  </div>
</div>
