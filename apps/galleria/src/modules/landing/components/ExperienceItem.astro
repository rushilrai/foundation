---
import { ExternalLinkIcon } from '@lucide/astro'

const { title, org, term, uri } = Astro.props
---

<a href={uri} target="_blank">
  <li
    class="experience-item-card relative flex w-full max-w-5xl flex-col justify-between gap-2 rounded-lg py-5 text-base-content sm:flex-row sm:items-center"
  >
    <div class="flex flex-col gap-1">
      <h2 class="font-body text-xl font-semibold">
        {title}
      </h2>
      <h3 class="font-body text-lg">{org}</h3>
    </div>

    <span class="text-lg font-medium sm:text-2xl">{term}</span>

    <ExternalLinkIcon
      size={20}
      class="experience-item-icon absolute top-1/2 right-6 -translate-y-1/2 opacity-0"
    />
  </li>
</a>

<script>
  import { animate, hover, press } from 'motion'

  import { getCSSVariable, isTouchDevice } from '../../common/utils'

  const experienceItem = document.querySelectorAll(
    '.experience-item-card',
  ) as NodeListOf<HTMLDivElement>

  const icon = (element: HTMLElement) =>
    element.querySelector('.experience-item-icon') as SVGElement

  // Keep every padding value in px: Motion converts mismatched units by
  // measuring the element, which produced a huge first-run jump.
  const PAD_Y_REST = 20
  const PAD_Y_OPEN = 32
  const ICON_ROOM = 40

  function open(element: HTMLElement, inset: number) {
    animate(element, {
      backgroundColor: getCSSVariable('--color-base-content'),
      color: getCSSVariable('--color-base-100'),
      paddingLeft: `${inset}px`,
      paddingRight: `${inset + ICON_ROOM}px`,
      paddingTop: `${PAD_Y_OPEN}px`,
      paddingBottom: `${PAD_Y_OPEN}px`,
    })
    animate(icon(element), { opacity: 1, x: [8, 0] })
  }

  function close(element: HTMLElement) {
    animate(element, {
      backgroundColor: getCSSVariable('--color-base-100'),
      color: getCSSVariable('--color-base-content'),
      paddingLeft: '0px',
      paddingRight: '0px',
      paddingTop: `${PAD_Y_REST}px`,
      paddingBottom: `${PAD_Y_REST}px`,
    })
    animate(icon(element), { opacity: 0, x: 8 })
  }

  if (experienceItem) {
    hover(experienceItem, (element) => {
      open(element, 24)

      return () => close(element)
    })

    if (isTouchDevice()) {
      press(experienceItem, (element) => {
        open(element, 16)

        return () => close(element)
      })
    }
  }
</script>
